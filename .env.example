# Copy this file to .env and fill in your Alpaca paper trading credentials
# Get keys from: https://app.alpaca.markets (Paper Trading section)

ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

ALPACA_OPTION_FEED=opra
ALPACA_STOCK_FEED=iex

SYMBOL=SPY
WATCHLIST=NVDA,AAPL,TSLA,MSFT,AMZN,GOOGL,META,NFLX,AVGO,AMD,BRK.B,JPM,V,LLY,WMT,COST
TARGET_DTE_DAYS=7
DTE_TOLERANCE_DAYS=3
SHORT_LEG_TARGET_DELTA=0.20
WING_TARGET_DELTA=0.08

DRY_RUN=true
I_UNDERSTAND_THIS_IS_LIVE=false
ENABLE_CREDIT_SPREADS=true
ENABLE_EQUITY_HEDGE=true
MIN_OPEN_INTEREST=0

MAX_GAMMA_RISK_PCT=0.0012
MAX_VEGA_RISK_PCT=0.04
TARGET_PORTFOLIO_VOL=0.16
MAX_DRAWDOWN_PCT=0.20
KELLY_FRACTION=0.40
KELLY_CLIP=0.25
MAX_CONTRACTS_PER_LEG=20

TRANSACTION_COST_BPS=3
HEDGE_RISK_AVERSION=3.0
REHEDGE_MIN_INTERVAL_MIN=10
MIN_VARIANCE_LOOKBACK_DAYS=15

# -- auto-exit thresholds --
ENABLE_AUTO_EXIT=true
EXIT_TAKE_PROFIT_PCT=0.50
EXIT_STOP_LOSS_PCT=0.35
EXIT_DTE_CLOSE_DAYS=1

# -- v3: new risk hard limits (see CHANGES_V3.md items 9/10) --
# NOTE: v3 also tightened the defaults actually baked into config.py itself
# (kelly_fraction 0.40->0.25, kelly_clip 0.25->0.15, target_portfolio_vol
# 0.16->0.10 as the center of an explicit 8-12% band) -- these .env values
# above (KELLY_FRACTION=0.40 etc.) OVERRIDE those new tighter defaults if
# left as shown; delete a line here to actually get config.py's new default
# instead of this file's older, wider one.
MAX_DELTA_RISK_PCT=0.15
MAX_THETA_RISK_PCT=0.01
TARGET_PORTFOLIO_VOL_MIN=0.08
TARGET_PORTFOLIO_VOL_MAX=0.12
MAX_DAILY_LOSS_PCT=0.04
MAX_WEEKLY_LOSS_PCT=0.08
MAX_PER_TRADE_LOSS_PCT=0.02
LONG_VOL_EDGE_THRESHOLD=0.35
SHORT_VOL_EDGE_THRESHOLD=0.0
CVAR_ALPHA=0.95
MAX_STRUCTURE_CVAR_PCT=0.03

# -- v3: new module toggles, each independently on/off (CHANGES_V3.md) --
ENABLE_EVENT_FILTER=true
ENABLE_ORDER_RECONCILIATION=true
ENABLE_PROBABILISTIC_VOL=true
ENABLE_EXECUTION_OPTIMIZER=false

# -- v3: execution-quality knobs (item 12) --
MAX_BID_ASK_SPREAD_PCT=0.25
MAX_QUOTE_AGE_SECONDS=15
COMMISSION_PER_CONTRACT=0.0

# -- v3: order-state-machine knob (item 15) --
STALE_ORDER_MAX_AGE_MINUTES=10

# -- v3: event-filter blackout widths, in trading days (item 8) --
FOMC_BLACKOUT_DAYS_BEFORE=1
FOMC_BLACKOUT_DAYS_AFTER=0
CPI_NFP_BLACKOUT_DAYS_BEFORE=0
CPI_NFP_BLACKOUT_DAYS_AFTER=0

# --- v4.2 trading controls (all optional; defaults shown) ---
# ENABLE_LONG_VOL=false              # buying straddles; off by default (premium decays)
# EXIT_CONDOR_TAKE_PROFIT_PCT=0.50   # close a condor at +50% of its credit
# EXIT_CONDOR_STOP_LOSS_PCT=1.00     # ...or at -100% of its credit (2x credit stop)
# EXIT_STRADDLE_TAKE_PROFIT_PCT=0.40
# EXIT_STRADDLE_STOP_LOSS_PCT=0.30
# EXIT_TRAIL_ACTIVATE_PCT=0.25       # once up 25%, exit if half of the best gain is given back
# EXIT_DTE_CLOSE_DAYS=2
# ENTRY_COOLDOWN_MINUTES=120
# AFTER_STOP_COOLDOWN_HOURS=24
# AVOID_OPEN_CLOSE_MINUTES=15
# MAX_BID_ASK_SPREAD_PCT=0.10
